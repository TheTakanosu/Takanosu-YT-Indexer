# Discord bot token (required)
# Discord Developer Portal -> Bot -> Message Content Intent must be enabled.
DISCORD_TOKEN=

# Fallback command prefix. Each server can override it with !setprefix.
COMMAND_PREFIX=!

# Data folder: holds the SQLite vault (vault.db) and generated exports.
DATA_DIR=data

# No Spotify credentials are needed — the Ghost Engine embed scraper reads
# public playlists and albums without an API key.
